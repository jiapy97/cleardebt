# LangSmith Configuration
# Get your API key from: https://smith.langchain.com/settings

# Enable LangSmith tracing
LANGCHAIN_TRACING_V2=true

# LangSmith endpoint (usually don't need to change)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Your LangSmith API key (replace with actual key)
LANGCHAIN_API_KEY=your-api-key-here

# Project name (can customize per environment)
LANGCHAIN_PROJECT=cleardebt-dev

# Optional: Hide sensitive data in traces
# LANGCHAIN_HIDE_INPUTS=true
# LANGCHAIN_HIDE_OUTPUTS=true

# Optional: Sampling (only trace X% of requests)
# LANGCHAIN_TRACING_SAMPLING_RATE=0.1
